FROM node:24-bookworm-slim AS frontend_builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY scripts ./scripts
COPY src ./src

ARG VITE_API_URL=/api
ARG VITE_GIS_API_URL=/gis-api
ARG VITE_APP_NAME="Система учета повреждений теплосетей"
ARG VITE_ENABLE_MOCK_FALLBACK=false
ARG VITE_MOCK_FALLBACK_MODULES=
ARG VITE_BASE_PATH=/

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GIS_API_URL=${VITE_GIS_API_URL}
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_ENABLE_MOCK_FALLBACK=${VITE_ENABLE_MOCK_FALLBACK}
ENV VITE_MOCK_FALLBACK_MODULES=${VITE_MOCK_FALLBACK_MODULES}
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

RUN npm run build

FROM nginx:1.30.3-alpine

COPY deploy/nginx/app.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend_builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1
