# Docker Compose
COMPOSE_PROJECT_NAME=web_gis
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Frontend build-time variables (public, embedded into the JS bundle)
VITE_API_URL=/api
VITE_GIS_API_URL=/gis-api
VITE_APP_NAME=Система учета повреждений теплосетей
VITE_ENABLE_MOCK_FALLBACK=false
VITE_MOCK_FALLBACK_MODULES=
VITE_BASE_PATH=/

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=gis.example.ru
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_BOOTSTRAP_DEV_AUTH=false
DJANGO_CORS_ALLOWED_ORIGINS=https://gis.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://gis.example.ru
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Gunicorn
BACKEND_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# PostgreSQL/PostGIS
POSTGRES_DB=web_gis
POSTGRES_USER=web_gis
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
